@page "/user"
@using Microsoft.AspNetCore.Components.Authorization
@using Music.Entity;
@layout TutorialsLayout
@inject NavigationManager NavigationManager
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

        <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="findUserID">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> 获取密钥
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="findMusic" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> 音乐搜索
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="LikeMusic">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 我的喜欢
                    </NavLink>
                </div>
            </nav>
        </div>
    </div>
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
