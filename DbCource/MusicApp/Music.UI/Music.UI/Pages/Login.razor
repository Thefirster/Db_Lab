@page "/Login"
@using Microsoft.AspNetCore.Components.Authorization
@using Music.Entity;
@layout TutorialsLoginLayout
@inject NavigationManager NavigationManager

<div class="login-item login-item-gitee">

    <div class="login-header">
        <span>登录</span>
        <div class="login-register">没有账号？<a href="/Register">点此注册</a></div>
    </div>

    <BootstrapInput @bind-Value="Model.Name" TValue="string" ShowLabel="false" PlaceHolder="请输入账号" />
    <BootstrapPassword @bind-Value="Model.Password" ShowLabel="false" PlaceHolder="请输入密码" />
    <div class="login-sms">
        <Checkbox TValue="bool" ShowLabel="false" ShowAfterLabel="true" DisplayText="记住我" />
    </div>

    <div class="row g-3">
        <div class="col-7 col-sm-5 col-md-3 col-lg-auto"><Button OnClick="LoginAsync" Color="Color.Primary" IsAsync="true">管理员登录</Button></div>
        <div class="col-7 col-sm-5 col-md-3 col-lg-auto"><Button OnClick="LoginUserAsync" Color="Color.Secondary" IsAsync="true">用户登录</Button></div>
    </div>

    <div class="text-center my-4">
        <a href="#">已有账号，忘记密码</a>
    </div>
    @if (IsError)
    {
        <Alert Color="Color.Danger">账号或密码错误</Alert>
    }
</div>

@code {
    [CascadingParameter]
    [NotNull]
    private User? Model { get; set; }

    private bool IsError { get; set; } = false;
    
    private async Task LoginAsync()
    {
        NavigationManager.NavigateTo("/");
    }
    private async Task LoginUserAsync()
    {
        NavigationManager.NavigateTo("/user");
    }
}













